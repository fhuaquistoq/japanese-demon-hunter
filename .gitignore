# =============================================================================
# japanese-demon-hunter
# Unity 6000.6.0f1 · URP · XR Plug-in Management / OpenXR · Meta Quest (Android)
# Core rules adapted from github/gitignore (Unity.gitignore).
# =============================================================================

# --- Local Pi / agent runtime state ------------------------------------------
.atl/

# --- Unity generated folders (rebuilt by the Editor, never commit) -----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Ee]xported[Oo]bj/
# MemoryCaptures can grow large and may contain sensitive data.
/[Mm]emoryCaptures/
# Recordings can grow large.
/[Rr]ecordings/

# --- IDE caches and generated solution / project files ----------------------
.vs/
.idea/
.consulo/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
# Autogenerated JetBrains Rider plugin.
/[Aa]ssets/Plugins/Editor/JetBrains*
# NOTE: .vscode/ stays tracked; it only holds shared team settings.

# --- Asset meta data ---------------------------------------------------------
# A .meta is ignored only together with the asset it belongs to (see below).
!/[Aa]ssets/**/*.meta

# --- Machine-local assets under Assets/ --------------------------------------
# Meta XR SDK Immersive Debugger Dev Agent: stores this machine's LAN address
# and a local access token. The SDK recreates it on demand when missing.
/[Aa]ssets/[Rr]esources/DevAgentSettings.asset
/[Aa]ssets/[Rr]esources/DevAgentSettings.asset.meta

# OpenXR API layers installed by Meta XR Operator: Windows-only binaries,
# generated per machine at build time.
/[Aa]ssets/XR/APILayers~/

# Unity Performance Testing output: per-machine hardware / OS report.
/[Aa]ssets/[Rr]esources/PerformanceTestRunInfo.json
/[Aa]ssets/[Rr]esources/PerformanceTestRunSettings.json
/[Aa]ssets/[Rr]esources/PerformanceTestRunInfo.json.meta
/[Aa]ssets/[Rr]esources/PerformanceTestRunSettings.json.meta

# --- Meta Quest / Android build output and credentials ----------------------
# Never commit signing material or an exported Gradle project.
*.keystore
*.jks
*.p12
keystore.properties
local.properties
*.apk
*.aab
*.unitypackage
*.app
# Unity/Cloud Build and Crashlytics generated files.
sysinfo.txt
crashlytics-build.properties

# --- OS junk ----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
